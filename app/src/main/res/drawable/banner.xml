<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 TV banner: blush glass card with a rose orb. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F7C6D9" android:endColor="#D9C8F5" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:left="40dp" android:top="30dp" android:right="160dp" android:bottom="30dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="60dp" android:startColor="#E58FB0" android:endColor="#00E58FB0" />
        </shape>
    </item>
    <item android:left="24dp" android:top="24dp" android:right="24dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#66FFFFFF" />
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>
